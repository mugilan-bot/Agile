# ============================================================
# FoodFlow Application Environment Configuration Template
# Copy this file to .env for local customized configuration
# ============================================================

# Application Environment (development | production)
ENVIRONMENT=development
IS_LOCAL_MODE=true

# Database Connection String
# Local SQLite default:
DATABASE_URL=sqlite:///./foodflow.db
# Azure SQL Database / PostgreSQL production alternative:
# DATABASE_URL=postgresql+psycopg2://<username>:<password>@<server-name>.postgres.database.azure.com:5432/foodflow

# Security & Session Token Encryption
SECRET_KEY=replace-with-a-secure-random-64-character-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Business Logic Defaults
DEFAULT_PREP_BUFFER=0.10
WASTE_ALERT_THRESHOLD_PCT=8.0
MIN_RETRAIN_RECORDS=500

# Azure Cloud Storage & Event Grid Configuration (Optional for Azure Mode)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your_storage_account>;AccountKey=<your_key>;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_RAW=foodflow-raw-uploads
AZURE_BLOB_CONTAINER_PROCESSED=foodflow-processed
AZURE_EVENT_GRID_ENDPOINT=https://<your-topic>.eastus-1.eventgrid.azure.net/api/events
AZURE_EVENT_GRID_KEY=<your_event_grid_key>
